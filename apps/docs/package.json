{
  "name": "@weapp-pandacss/docs",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "English and Chinese documentation for weapp-pandacss",
  "author": "ice breaker <1324318532@qq.com>",
  "license": "MIT",
  "homepage": "https://panda.weapp.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/weapp-pandacss/weapp-pandacss.git",
    "directory": "apps/docs"
  },
  "bugs": {
    "url": "https://github.com/weapp-pandacss/weapp-pandacss/issues"
  },
  "engines": {
    "node": "^22.23.4 || ^24.22.1 || >=26.12.1"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "pnpm check:locales && astro build",
    "preview": "astro preview",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint . && stylelint \"src/styles/**/*.css\" && nimbus-docs lint",
    "lint:docs": "nimbus-docs lint",
    "lint:docs:fix": "nimbus-docs lint --fix",
    "check:locales": "node scripts/check-locales.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "test:e2e": "pnpm build && playwright test --config=../../e2e/docs/playwright.config.ts",
    "deploy:check": "node scripts/check-deployment-channels.mjs"
  },
  "dependencies": {
    "@cloudflare/nimbus-docs": "0.19.4",
    "astro": "7.4.11"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@astrojs/language-server": "2.17.3",
    "astro-eslint-parser": "^3.2.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-mdx": "^3.9.5",
    "pagefind": "^1.6.0",
    "typescript": "catalog:",
    "wrangler": "^4.160.1"
  }
}
